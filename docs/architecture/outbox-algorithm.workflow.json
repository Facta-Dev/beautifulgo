  "cards": [
    {
      "dot": "cyan",
      "title": "Transactional enqueue",
      "items": [
        "auth use-cases INSERT email_jobs in the same pgx transaction as the users/sessions writes — no dual-write gap (platform/email/queue.go, deliberately sqlc-free)",
        "the claim CTE takes queued rows due now PLUS sending rows older than the 5-minute lease, FOR UPDATE SKIP LOCKED — at-least-once, replica-safe"
      ]
    },
    {
      "dot": "emerald",
      "title": "Drain",
      "items": [
        "the worker polls every <APP>_OUTBOX_POLL (2s) with batch <APP>_OUTBOX_BATCH (10); cmd/api runs one in-process worker, cmd/worker a standalone drain",
        "SelectSender picks Console when <APP>_OFFLINE=true or the SMTP host is empty; otherwise net/smtp PlainAuth STARTTLS"
      ]
    },
    {
      "dot": "rose",
      "title": "Outcomes",
      "items": [
        "success lands sent with sent_at; failure backs off 2^n minutes with ±20% jitter up to max_retries 3, then dead-letters to status failed",
        "the janitor loop (<APP>_JANITOR_POLL 1h) purges expired sessions and code rows; audit_logs is never touched"
      ]
    }
  ]
