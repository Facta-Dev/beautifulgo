  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-broker outbox",
      "items": [
        "the enqueue rides the same pgx transaction as the auth write — no dual-write gap, at-least-once by construction",
        "claim = queued due now OR sending older than the 5-minute lease, FOR UPDATE SKIP LOCKED, safe per replica"
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery",
      "items": [
        "render + send: templates live in platform/email; Console when <APP>_OFFLINE or host empty, else net/smtp PlainAuth STARTTLS",
        "batch <APP>_OUTBOX_BATCH (10) per tick, poll <APP>_OUTBOX_POLL (2s) — one in-process worker in cmd/api or a standalone cmd/worker"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure + purge",
      "items": [
        "failure requeues with 2^n-minute backoff (±20% jitter) and dead-letters to failed at max_retries 3 — visible in email_jobs and in slog rows",
        "the janitor sweeps expired sessions, email_verifications and password_resets hourly; it never touches audit rows or rotation history"
      ]
    }
  ]
