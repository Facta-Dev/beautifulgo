  "cards": [
    {
      "dot": "cyan",
      "title": "One transaction",
      "items": [
        "signup writes the user, the code row and the email_jobs job in the same pgx transaction — zero-broker outbox",
        "claims use FOR UPDATE SKIP LOCKED; the 5-minute sending lease recovers a crashed worker"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code lifecycle",
      "items": [
        "codes expire in 24h, cap at 5 wrong guesses and are consumed on verify; resets run 30m",
        "resend never reveals whether the account exists; re-signup of a verified email answers 409"
      ]
    },
    {
      "dot": "rose",
      "title": "Login + tokens",
      "items": [
        "password first — one constant 401; then inactive → blocked → unverified, each a stable 403",
        "access JWT 15m; refresh is a 128-char opaque token rotated in place (replay misses the CAS → 401)"
      ]
    }
  ]
